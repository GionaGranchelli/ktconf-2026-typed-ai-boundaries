# Optional REAL-provider configuration for the KTConf demo.
# Copy to .env (or export in your shell) ONLY for the off-stage
# preflight-real proof. The deterministic conference run never reads these:
# preflight / rehearse / stress-rehearse / stage-up all unset them.
#
# Leave everything empty (or unset) → both providers stay deterministic.

# LOCAL identity: Qwen3.8-27B-UD-Q6_K on the z840, reached over Tailscale.
# The exact endpoint is private — supply your own Tailscale address.
# The trust zone (LOCAL) is an OPERATOR assertion in application.yml,
# never inferred from this URL.
KTCONF_DEMO_LOCAL_BASE_URL=<private z840 Tailscale OpenAI-compatible endpoint, e.g. http://100.x.x.x:8088/v1>
# Exact model id served by llama.cpp on the z840 (full GGUF path — verified live).
KTCONF_DEMO_LOCAL_MODEL=/home/fedora-workstation/models/Qwen3.8-27B-UD-Q6_K.gguf
KTCONF_DEMO_LOCAL_API_KEY=

# CLOUD identity: DeepSeek V4 Flash (OpenAI-compatible).
KTCONF_DEMO_CLOUD_BASE_URL=https://api.deepseek.com
KTCONF_DEMO_CLOUD_MODEL=deepseek-v4-flash
KTCONF_DEMO_CLOUD_API_KEY=<secret>

# NEVER commit real credentials or private endpoint details.
