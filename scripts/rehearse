#!/usr/bin/env bash
# The whole deterministic suite, once. The 20/20 gate lives in
# ./scripts/stress-rehearse.
set -euo pipefail
cd "$(dirname "$0")/.."

(
  unset KTCONF_DEMO_LOCAL_BASE_URL
  unset KTCONF_DEMO_LOCAL_MODEL
  unset KTCONF_DEMO_LOCAL_API_KEY
  unset KTCONF_DEMO_CLOUD_BASE_URL
  unset KTCONF_DEMO_CLOUD_MODEL
  unset KTCONF_DEMO_CLOUD_API_KEY
  unset KTCONF_GTC_LOCAL_NVIDIA_BASE_URL
  unset KTCONF_GTC_LOCAL_NVIDIA_MODEL
  unset KTCONF_GTC_LOCAL_NVIDIA_API_KEY
  unset KTCONF_GTC_GLOBAL_NVIDIA_BASE_URL
  unset KTCONF_GTC_GLOBAL_NVIDIA_MODEL
  unset KTCONF_GTC_GLOBAL_NVIDIA_API_KEY
  unset KTCONF_GTC_EU_SCALEWAY_BASE_URL
  unset KTCONF_GTC_EU_SCALEWAY_MODEL
  unset KTCONF_GTC_EU_SCALEWAY_API_KEY
  unset SCW_BASE_URL
  unset SCW_MODEL
  unset SCW_API_KEY
  ./gradlew :app:test --rerun
)
