#!/usr/bin/env bash
# The whole deterministic suite, once. The 20/20 gate lives in
# ./scripts/stress-rehearse.
set -euo pipefail
cd "$(dirname "$0")/.."

(
  unset KTCONF_DEMO_LOCAL_BASE_URL
  unset KTCONF_DEMO_LOCAL_MODEL
  unset KTCONF_DEMO_LOCAL_API_KEY
  unset KTCONF_DEMO_CLOUD_BASE_URL
  unset KTCONF_DEMO_CLOUD_MODEL
  unset KTCONF_DEMO_CLOUD_API_KEY
  ./gradlew :app:test --rerun
)
