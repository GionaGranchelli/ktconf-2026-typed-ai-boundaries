#!/usr/bin/env bash
# Bring the conference stage up: ONE application, ONE process, ONE port.
# The deterministic oracle is sacred: KTCONF_DEMO_LOCAL_* are UNSET for the
# launched process so the stage always runs the deterministic providers,
# regardless of what is running on the network.
#
# Hardened sequence: stop stale instances -> verify port 8080 free -> verify
# the pinned submodule -> ALWAYS build the current bootJar -> start ONE app
# -> verify the launched PID stays alive -> /healthz must answer.
set -euo pipefail
cd "$(dirname "$0")/.."

./scripts/stage-down

expected="$(grep '^tramaiGitCommit=' gradle.properties | cut -d= -f2)"
actual="$(git -C vendor/tramai rev-parse HEAD 2>/dev/null || echo MISSING)"
if [ "$expected" != "$actual" ]; then
  echo "FAIL: vendor/tramai is not at the pinned revision ($expected)." >&2
  exit 1
fi

echo "building current bootJar…"
./gradlew :app:bootJar -q
JAR="app/build/libs/ktconf-demo.jar"

# Port 8080 must be free before we start (stage-down kills, then java needs
# a moment to release the socket).
for i in $(seq 1 30); do
  if ! curl -sf --max-time 1 "http://localhost:8080/governance/healthz" >/dev/null 2>&1; then
    break
  fi
  sleep 1
done
if curl -sf --max-time 1 "http://localhost:8080/governance/healthz" >/dev/null 2>&1; then
  echo "FAIL: port 8080 still responds after stage-down." >&2
  exit 1
fi
echo "port 8080 free"

mkdir -p .build
rm -f .build/stage.pid

echo "starting ktconf-demo.jar on :8080 (deterministic providers) …"
# Deterministic means deterministic: never let a real-provider env var leak
# into the stage process and swap either identity for a network client.
env -u KTCONF_DEMO_LOCAL_BASE_URL -u KTCONF_DEMO_LOCAL_MODEL -u KTCONF_DEMO_LOCAL_API_KEY \
    -u KTCONF_DEMO_CLOUD_BASE_URL -u KTCONF_DEMO_CLOUD_MODEL -u KTCONF_DEMO_CLOUD_API_KEY \
    -u KTCONF_GTC_LOCAL_NVIDIA_BASE_URL -u KTCONF_GTC_LOCAL_NVIDIA_MODEL -u KTCONF_GTC_LOCAL_NVIDIA_API_KEY \
    -u KTCONF_GTC_GLOBAL_NVIDIA_BASE_URL -u KTCONF_GTC_GLOBAL_NVIDIA_MODEL -u KTCONF_GTC_GLOBAL_NVIDIA_API_KEY \
    -u KTCONF_GTC_EU_SCALEWAY_BASE_URL -u KTCONF_GTC_EU_SCALEWAY_MODEL -u KTCONF_GTC_EU_SCALEWAY_API_KEY \
    -u SCW_BASE_URL -u SCW_MODEL -u SCW_API_KEY \
    -u SCW_SECRET_KEY \
  SERVER_PORT=8080 nohup java -jar "$JAR" > .build/stage.log 2>&1 &
echo "$!" > .build/stage.pid
PID="$(cat .build/stage.pid)"

for i in $(seq 1 60); do
  if ! kill -0 "$PID" 2>/dev/null; then
    echo "FAIL: stage process died during startup." >&2
    tail -20 .build/stage.log >&2
    exit 1
  fi
  if curl -sf --max-time 2 "http://localhost:8080/governance/healthz" 2>/dev/null | grep -Fq '"status":"ok"'; then
    echo "  demo :8080 responding"
    exit 0
  fi
  sleep 1
done
echo "FAIL: app did not report healthy within 60s." >&2
tail -20 .build/stage.log >&2
exit 1
