#!/usr/bin/env bash
# Bring the conference stage up: the SAME bootJar, one profile per port.
#   demo :8080   broken :8081   cloud-routing :8082   real :8083 (optional)
# All instances start BEFORE the talk and stay up; the talk never restarts
# Spring Boot. stage-up blocks until every expected instance responds.
set -euo pipefail
cd "$(dirname "$0")/.."

JAR="app/build/libs/ktconf-demo.jar"
if [ ! -f "$JAR" ]; then
  echo "building $JAR …"
  ./gradlew :app:bootJar -q
fi

mkdir -p .build
rm -f .build/stage.pids

start() { # $1=profile  $2=port
  echo "starting $1 on :$2 …"
  SPRING_PROFILES_ACTIVE="$1" SERVER_PORT="$2" nohup java -jar "$JAR" \
    > ".build/stage-$1.log" 2>&1 &
  echo "$!" >> .build/stage.pids
}

start demo 8080
start broken 8081
start cloud-routing 8082
real_started=0
if [ -n "${KTCONF_DEMO_LOCAL_BASE_URL:-}" ]; then
  start real 8083
  real_started=1
fi

# Wait until every expected instance responds (the talk's /healthz).
wait_for() { # $1=profile  $2=port
  for i in $(seq 1 60); do
    if curl -sf --max-time 2 "http://localhost:$2/governance/healthz" >/dev/null 2>&1; then
      echo "  $1 :$2 responding"
      return 0
    fi
    sleep 1
  done
  echo "FAIL: $1 on :$2 did not respond within 60s." >&2
  tail -20 ".build/stage-$1.log" >&2
  exit 1
}

wait_for demo 8080
wait_for broken 8081
wait_for cloud-routing 8082
[ "$real_started" = 1 ] && wait_for real 8083

echo
echo "stage-up OK — instances are up and responding. Talk away."
echo "logs in .build/stage-*.log; stop with ./scripts/stage-down"
