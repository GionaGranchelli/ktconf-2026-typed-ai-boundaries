#!/usr/bin/env bash
# Conference-morning check for the real-model path (typed --real).
# Contract: env configured -> endpoint reachable -> model reachable ->
# exact current binary built -> typed --real MUST produce a typed
# InvoiceAssessment -> PASS. Independent of the deterministic ./scripts/preflight.
set -euo pipefail
cd "$(dirname "$0")/.."

if [ -z "${JAVA_HOME:-}" ] && [ -d /usr/lib/jvm/java-21-openjdk-amd64 ]; then
  export JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
fi

: "${KTCONF_DEMO_LOCAL_BASE_URL:?KTCONF_DEMO_LOCAL_BASE_URL is required (e.g. http://localhost:11434/v1 or https://api.deepseek.com)}"
: "${KTCONF_DEMO_LOCAL_MODEL:?KTCONF_DEMO_LOCAL_MODEL is required (e.g. gemma-4-12b-it:q5_k_m or deepseek-chat)}"

base="${KTCONF_DEMO_LOCAL_BASE_URL%/}"
echo "base URL   : $base"
echo "model      : $KTCONF_DEMO_LOCAL_MODEL"

# Auth: honor the same key the demo uses (never echoed).
curl_args=(-sf --max-time 10)
if [ -n "${KTCONF_DEMO_LOCAL_API_KEY:-}" ]; then
  curl_args+=(-H "Authorization: Bearer $KTCONF_DEMO_LOCAL_API_KEY")
  echo "auth       : bearer token configured"
else
  echo "auth       : none"
fi

# Endpoint reachable: some servers serve /models at root, some under /v1.
models_url=""
for candidate in "$base/models" "$base/v1/models"; do
  if curl "${curl_args[@]}" "$candidate" >/dev/null 2>&1; then
    models_url="$candidate"
    break
  fi
done
if [ -z "$models_url" ]; then
  echo "FAIL: endpoint not reachable at $base/models (or $base/v1/models)." >&2
  exit 1
fi
echo "endpoint   : reachable ($models_url)"

# Model reachable: the configured name must be served (literal match).
if ! curl "${curl_args[@]}" "$models_url" | grep -Fq -- "$KTCONF_DEMO_LOCAL_MODEL"; then
  echo "FAIL: model '$KTCONF_DEMO_LOCAL_MODEL' not served by $models_url." >&2
  exit 1
fi
echo "model      : reachable"

# Build the exact current binary — a preflight must prove THIS source, not a
# stale installed distribution.
echo "building stage binary…"
./gradlew :app:bootJar -q

# The real requirement: the real profile must produce a typed result over
# HTTP (RealModelTest boots a real-profile instance and calls the same
# endpoint the talk uses). Env-gated: it activates exactly when the
# KTCONF_DEMO_LOCAL_* vars are set, which they are here.
if ! SPRING_PROFILES_ACTIVE=real ./gradlew :app:test --tests 'dev.giona.ktconf.RealModelTest' --rerun; then
  echo "FAIL: real profile did not produce a typed InvoiceAssessment." >&2
  exit 1
fi
echo "real-model HTTP: typed assessment OK"

echo
echo "preflight-real OK — real-model path ready."
