#!/usr/bin/env bash
# Conference-morning check for the OPTIONAL real-model path.
# Contract: env configured -> exact current binary built -> app started with
# the real local provider -> RESTRICTED KTCONF-001 MUST produce a typed
# InvoiceAssessment over HTTP -> PASS.
# Completely independent of ./scripts/preflight: this never runs unless the
# KTCONF_DEMO_LOCAL_* vars are set explicitly.
set -euo pipefail
cd "$(dirname "$0")/.."

if [ -z "${JAVA_HOME:-}" ] && [ -d /usr/lib/jvm/java-21-openjdk-amd64 ]; then
  export JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
fi

: "${KTCONF_DEMO_LOCAL_BASE_URL:?KTCONF_DEMO_LOCAL_BASE_URL is required (e.g. http://localhost:11434/v1)}"
: "${KTCONF_DEMO_LOCAL_MODEL:?KTCONF_DEMO_LOCAL_MODEL is required (e.g. gemma-4-12b-it:q5_k_m)}"

base="${KTCONF_DEMO_LOCAL_BASE_URL%/}"
echo "base URL   : $base (declared LOCAL by operator assertion, never by URL)"
echo "model      : $KTCONF_DEMO_LOCAL_MODEL"

# Endpoint reachable: some servers serve /models at root, some under /v1.
curl_args=(-sf --max-time 10)
if [ -n "${KTCONF_DEMO_LOCAL_API_KEY:-}" ]; then
  curl_args+=(-H "Authorization: Bearer ${KTCONF_DEMO_LOCAL_API_KEY}")
  echo "auth       : bearer token configured"
else
  echo "auth       : none"
fi

models_url=""
for candidate in "$base/models" "$base/v1/models"; do
  if curl "${curl_args[@]}" "$candidate" >/dev/null 2>&1; then
    models_url="$candidate"
    break
  fi
done
if [ -z "$models_url" ]; then
  echo "FAIL: endpoint not reachable at $base/models (or $base/v1/models)." >&2
  exit 1
fi
echo "endpoint   : reachable ($models_url)"

if ! curl "${curl_args[@]}" "$models_url" | grep -Fq -- "$KTCONF_DEMO_LOCAL_MODEL"; then
  echo "FAIL: model '$KTCONF_DEMO_LOCAL_MODEL' not served by $models_url." >&2
  exit 1
fi
echo "model      : reachable"

# Build the exact current binary — a preflight must prove THIS source.
echo "building stage binary…"
./gradlew :app:bootJar -q

# Boot the ONE app with the real local provider and prove the typed contract.
./scripts/stage-down
mkdir -p .build
# Only set the API key when it was supplied — an empty value must NOT become
# a blank bearer token (the provider defaults to a local-dev placeholder).
api_key="${KTCONF_DEMO_LOCAL_API_KEY:-}"
unset KTCONF_DEMO_LOCAL_API_KEY
if [ -n "$api_key" ]; then
  KTCONF_DEMO_LOCAL_API_KEY="$api_key"
fi
KTCONF_DEMO_LOCAL_BASE_URL="$KTCONF_DEMO_LOCAL_BASE_URL" \
KTCONF_DEMO_LOCAL_MODEL="$KTCONF_DEMO_LOCAL_MODEL" \
SERVER_PORT=8080 nohup java -jar app/build/libs/ktconf-demo.jar \
  > .build/stage-real.log 2>&1 &
echo "$!" > .build/stage.pid

cleanup() { ./scripts/stage-down >/dev/null 2>&1 || true; }
trap cleanup EXIT

for i in $(seq 1 60); do
  if ! kill -0 "$(cat .build/stage.pid)" 2>/dev/null; then
    echo "FAIL: app died during real-model startup." >&2
    tail -20 .build/stage-real.log >&2
    exit 1
  fi
  if curl -sf --max-time 2 "http://localhost:8080/governance/healthz" >/dev/null 2>&1; then
    break
  fi
  sleep 1
done

payload='{"classification":"RESTRICTED","invoice":{"invoiceId":"KTCONF-001","supplierName":"KTConf Catering BV","amountCents":42830,"currency":"EUR","description":"Conference catering services"}}'
http_code="$(curl -s -o .build/real-response.json -w '%{http_code}' --max-time 90 \
  -X POST "http://localhost:8080/invoices/analyze" \
  -H 'Content-Type: application/json' -d "$payload")"

if [ "$http_code" != "200" ]; then
  echo "FAIL: real-model analyze returned HTTP $http_code (expected 200)." >&2
  cat .build/real-response.json >&2
  exit 1
fi
if ! grep -Fq '"invoiceId":"KTCONF-001"' .build/real-response.json; then
  echo "FAIL: real-model response is not a typed InvoiceAssessment." >&2
  cat .build/real-response.json >&2
  exit 1
fi

echo "real-model HTTP: typed assessment OK"
echo
echo "preflight-real OK — real-model path ready (same typed contract, real LLM)."
