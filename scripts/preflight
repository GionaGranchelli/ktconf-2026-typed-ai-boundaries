#!/usr/bin/env bash
# Clean-machine preparation: verify the pinned TramAI revision, run the
# full deterministic test suite, and build the stage binary.
# This is a PREPARATION step — after it succeeds, the stage demo runs
# offline (airplane mode is fine).
set -euo pipefail
cd "$(dirname "$0")/.."

if [ -z "${JAVA_HOME:-}" ] && [ -d /usr/lib/jvm/java-21-openjdk-amd64 ]; then
  export JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
fi

expected="$(grep '^tramaiGitCommit=' gradle.properties | cut -d= -f2)"
actual="$(git -C vendor/tramai rev-parse HEAD 2>/dev/null || echo MISSING)"

echo "tramai pinned commit : $expected"
echo "submodule HEAD       : $actual"
if [ "$expected" != "$actual" ]; then
  echo "FAIL: vendor/tramai is not at the pinned revision." >&2
  echo "      Run: git -C vendor/tramai checkout $expected" >&2
  exit 1
fi

dirty="$(git -C vendor/tramai status --short)"
if [ -n "$dirty" ]; then
  echo "FAIL: vendor/tramai working tree is dirty:" >&2
  echo "$dirty" >&2
  echo "      Revert conference-side changes only; never commit inside the submodule." >&2
  exit 1
fi
echo "submodule clean      : yes"

# Deterministic means deterministic: sanitize BOTH real-provider families
# (local z840/Qwen AND cloud DeepSeek). A DeepSeek API key accidentally
# present in the operator's shell must never reach the conference stage.
(
    unset KTCONF_DEMO_LOCAL_BASE_URL
    unset KTCONF_DEMO_LOCAL_MODEL
    unset KTCONF_DEMO_LOCAL_API_KEY
    unset KTCONF_DEMO_CLOUD_BASE_URL
    unset KTCONF_DEMO_CLOUD_MODEL
    unset KTCONF_DEMO_CLOUD_API_KEY
    ./gradlew :app:test --rerun
)
echo "building stage binary…"
./gradlew :app:bootJar

echo
echo "preflight OK — deterministic demo ready. A stage laptop may now go offline."
