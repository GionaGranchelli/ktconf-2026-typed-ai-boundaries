#!/usr/bin/env bash
# Stop the ONE stage application started by ./scripts/stage-up (PID file
# only — no broad pkill patterns).
set -euo pipefail
cd "$(dirname "$0")/.."

if [ -f .build/stage.pid ]; then
  pid="$(cat .build/stage.pid)"
  if kill -0 "$pid" 2>/dev/null; then
    kill "$pid"
    echo "stage-down: stopped stage process $pid."
  else
    echo "stage-down: pid $pid not running."
  fi
  rm -f .build/stage.pid
else
  echo "stage-down: no pid file; nothing to stop."
fi
