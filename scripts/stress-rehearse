#!/usr/bin/env bash
# Deterministic rehearsal stress gate — the conference bar, always 20/20 per
# profile. Runs the FULL deterministic oracle 20 times on fresh contexts per
# profile (demo: typed/deny/approve/duplicate/evidence; broken: 422; cloud:
# 403 + count 0) and verifies the result XMLs. Ends with a pass line.
set -euo pipefail
cd "$(dirname "$0")/.."

./gradlew :app:test --tests 'dev.giona.ktconf.RehearsalDemoIT' \
                   --tests 'dev.giona.ktconf.RehearsalBrokenIT' \
                   --tests 'dev.giona.ktconf.RehearsalCloudIT' \
                   --rerun

verify() { # $1=class  $2=label
  xml="app/build/test-results/test/TEST-dev.giona.ktconf.$1.xml"
  if [ ! -f "$xml" ]; then
    echo "FAIL: $xml not found." >&2
    exit 1
  fi
  count="$(grep -o 'tests="[0-9]*"' "$xml" | head -1 | grep -o '[0-9]*')"
  failures="$(grep -o 'failures="[0-9]*"' "$xml" | head -1 | grep -o '[0-9]*')"
  if [ "$count" != "20" ] || [ "$failures" != "0" ]; then
    echo "FAIL: $2 expected 20/20, got tests=$count failures=$failures." >&2
    exit 1
  fi
  printf '  %-6s 20/20 PASS\n' "$2"
}

verify RehearsalDemoIT demo
verify RehearsalBrokenIT broken
verify RehearsalCloudIT cloud

echo
echo "KTConf deterministic rehearsal"
echo "demo 20/20 · broken 20/20 · cloud 20/20"
echo "60 / 60 PASS"
