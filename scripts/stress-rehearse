#!/usr/bin/env bash
# Deterministic rehearsal stress gate — the conference bar: the FULL
# deterministic oracle 20/20 on fresh contexts. Runs RehearsalIT (which
# repeats the complete storyline 20 times) and verifies the result XML.
# Ends with a pass line.
set -euo pipefail
cd "$(dirname "$0")/.."

# Deterministic means deterministic: sanitize the real-provider env
# (local z840/Qwen AND cloud DeepSeek).
(
  unset KTCONF_DEMO_LOCAL_BASE_URL
  unset KTCONF_DEMO_LOCAL_MODEL
  unset KTCONF_DEMO_LOCAL_API_KEY
  unset KTCONF_DEMO_CLOUD_BASE_URL
  unset KTCONF_DEMO_CLOUD_MODEL
  unset KTCONF_DEMO_CLOUD_API_KEY
  ./gradlew :app:test --tests 'dev.giona.ktconf.RehearsalIT' --rerun
)

xml="app/build/test-results/test/TEST-dev.giona.ktconf.RehearsalIT.xml"
if [ ! -f "$xml" ]; then
  echo "FAIL: $xml not found." >&2
  exit 1
fi
count="$(grep -o 'tests="[0-9]*"' "$xml" | head -1 | grep -o '[0-9]*')"
failures="$(grep -o 'failures="[0-9]*"' "$xml" | head -1 | grep -o '[0-9]*')"
if [ "$count" != "20" ] || [ "$failures" != "0" ]; then
  echo "FAIL: RehearsalIT expected 20/20, got tests=$count failures=$failures." >&2
  exit 1
fi

echo
echo "KTConf deterministic rehearsal"
echo "oracle 20/20 (typed · restricted · restricted-cloud · invalid · payment · approve · deny · evidence)"
echo "20 / 20 PASS"
