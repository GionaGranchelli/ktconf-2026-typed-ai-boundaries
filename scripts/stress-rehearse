#!/usr/bin/env bash
# Deterministic rehearsal stress gate: run the full HTTP storyline N times
# (default 20) against fresh application contexts, then verify the result
# XML reports exactly N passing repetitions. Ends with a pass line.
#
#   ./scripts/stress-rehearse [N]
set -euo pipefail
cd "$(dirname "$0")/.."

N="${1:-20}"

./gradlew :app:test --tests 'dev.giona.ktconf.RehearsalIT' --rerun

xml="app/build/test-results/test/TEST-dev.giona.ktconf.RehearsalIT.xml"
if [ ! -f "$xml" ]; then
  echo "FAIL: $xml not found." >&2
  exit 1
fi
count="$(grep -o 'tests="[0-9]*"' "$xml" | head -1 | grep -o '[0-9]*')"
failures="$(grep -o 'failures="[0-9]*"' "$xml" | head -1 | grep -o '[0-9]*')"

if [ "$count" != "$N" ] || [ "$failures" != "0" ]; then
  echo "FAIL: expected $N repetitions, got tests=$count failures=$failures." >&2
  exit 1
fi

echo
echo "KTConf deterministic rehearsal"
echo "$N / $N PASS"
