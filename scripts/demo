#!/usr/bin/env bash
# Stage API — stable commands over the ONE running application.
# Instances are started once via ./scripts/stage-up (one process on :8080),
# then this script only curls it. No ports/profiles to remember.
#
#   ./scripts/demo typed            -> PUBLIC  KTCONF-001       -> cloud route, 200 typed
#   ./scripts/demo restricted       -> RESTRICTED KTCONF-001    -> local route, 200 typed
#   ./scripts/demo restricted-cloud -> RESTRICTED forced cloud  -> 403 + invocation delta 0
#   ./scripts/demo invalid          -> PUBLIC  KTCONF-INVALID   -> 422 (same app/runtime)
#   ./scripts/demo payment          -> RESTRICTED KTCONF-PAY-001-> 202 + approvalId
#   ./scripts/demo workflow-typed   -> PUBLIC invoice through explicit TramAI workflow
#   ./scripts/demo workflow-payment -> assess -> approve gate -> email notification -> 202
#   ./scripts/demo approve <id>     -> POST /approvals/<id>/approve
#   ./scripts/demo deny <id>        -> POST /approvals/<id>/deny
#   ./scripts/demo evidence <id>    -> GET /approvals/<id>/evidence
#   ./scripts/demo stats            -> GET /governance/stats
#   ./scripts/demo healthz          -> GET /governance/healthz
#
# The optional real-model proof is ./scripts/preflight-real (off-stage);
# the stage app itself is always deterministic (stage-up unsets the
# real-model env).
set -euo pipefail
cd "$(dirname "$0")/.."

BASE="http://localhost:${KTCONF_DEMO_PORT:-8080}"

analyze() { # $1=json
  curl -s -w '\nHTTP %{http_code}\n' -X POST "$BASE/invoices/analyze" \
    -H 'Content-Type: application/json' -d "$1"
}

workflow_analyze() { # $1=json
  curl -s -w '\nHTTP %{http_code}\n' -X POST "$BASE/workflow-demo/analyze" \
    -H 'Content-Type: application/json' -d "$1"
}

CATERING='{"classification":"PUBLIC","invoice":{"invoiceId":"KTCONF-001","supplierName":"KTConf Catering BV","amountCents":42830,"currency":"EUR","description":"Conference catering services"}}'
CATERING_RESTRICTED='{"classification":"RESTRICTED","invoice":{"invoiceId":"KTCONF-001","supplierName":"KTConf Catering BV","amountCents":42830,"currency":"EUR","description":"Conference catering services"}}'
INVALID='{"classification":"PUBLIC","invoice":{"invoiceId":"KTCONF-INVALID-001","supplierName":"KTConf","amountCents":42830,"currency":"EUR","description":"Broken"}}'
PAYMENT='{"classification":"RESTRICTED","invoice":{"invoiceId":"KTCONF-PAY-001","supplierName":"KTConf AV & Stage Services BV","amountCents":1840000,"currency":"EUR","description":"Stage and AV production services"}}'

stats() { curl -s "$BASE/governance/stats"; }
cloud_count() { stats | python3 -c "import sys,json; print(json.load(sys.stdin)['cloudInvocationCount'])"; }

case "${1:-}" in
  typed)
    analyze "$CATERING"
    ;;
  restricted)
    analyze "$CATERING_RESTRICTED"
    ;;
  restricted-cloud)
    before="$(cloud_count)"
    echo "cloud invocations before = $before"
    curl -s -w '\nHTTP %{http_code}\n' -X POST "$BASE/invoices/boundary/restricted-cloud" \
      -H 'Content-Type: application/json' -d "$CATERING_RESTRICTED"
    after="$(cloud_count)"
    echo "cloud invocations after  = $after"
    echo "cloud invocation delta   = $((after - before))"
    ;;
  invalid)
    analyze "$INVALID"
    ;;
  payment)
    analyze "$PAYMENT"
    ;;
  workflow-typed)
    workflow_analyze "$CATERING"
    ;;
  workflow-payment)
    workflow_analyze "$PAYMENT"
    ;;
  approve)
    curl -s -w '\nHTTP %{http_code}\n' -X POST "$BASE/approvals/${2:?usage: ./scripts/demo approve <approvalId>}/approve"
    ;;
  deny)
    curl -s -w '\nHTTP %{http_code}\n' -X POST "$BASE/approvals/${2:?usage: ./scripts/demo deny <approvalId>}/deny"
    ;;
  evidence)
    curl -s -w '\nHTTP %{http_code}\n' "$BASE/approvals/${2:?usage: ./scripts/demo evidence <approvalId>}/evidence"
    ;;
  stats)
    curl -s -w '\nHTTP %{http_code}\n' "$BASE/governance/stats"
    ;;
  healthz)
    curl -s -w '\nHTTP %{http_code}\n' "$BASE/governance/healthz"
    ;;
  *)
    echo "usage: ./scripts/demo {typed|restricted|restricted-cloud|invalid|payment|workflow-typed|workflow-payment|approve <id>|deny <id>|evidence <id>|stats|healthz}" >&2
    exit 2
    ;;
esac
